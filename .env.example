# jobMate 로컬 개발 설정 — 실제 값은 .env에만 (커밋 금지)
# LLM (OpenAI 호환 엔드포인트)
GEMINI_API_KEY=
JOBMATE_LLM_BASE_URL=
JOBMATE_DEFAULT_MODEL=
# Codex 구독 (release 모드 important 티어)
JOBMATE_CODEX_BASE_URL=
JOBMATE_CODEX_API_KEY_ENV=
JOBMATE_IMPORTANT_MODEL=
# debug=gemini만 / release=gemini+codex 라우팅
JOBMATE_MODE=
# 에이전트/스테이지별 모델 직접 지정 — JSON 객체 {"<agent|stage key>": "<model>"}
# agent key: analysis|implementer|security|reviewer|qa|extractor
# stage key: analysis|implement|auto_checks|security|code_review|qa|approval|...
# 예: JOBMATE_AGENT_MODELS={"security":"gpt-5","qa":"claude-sonnet"}
# ModelConfig의 나머지 필드(base_url/api_key/temperature 등)는 그대로 유지.
# 잘못된 JSON이면 경고 후 무시.
JOBMATE_AGENT_MODELS=
# 저장소 — JOBMATE_DATABASE_URL이 있으면 PostgreSQL, 없으면 DB_PATH의 SQLite
JOBMATE_DB_PATH=
# postgres://user:pass@host:5432/db (Vercel Postgres는 POSTGRES_URL 자동 인식)
JOBMATE_DATABASE_URL=
# Vercel Cron 인증 시크릿 (VERCEL 환경에서 CRON_SECRET과 동일하게 설정)
JOBMATE_CRON_SECRET=
# calendar-agent 연동 — 토큰 파일 경로를 지정하면 실제 Google API 사용
# 발급: jobmate google-auth gmail|calendar --client-id ... --client-secret ... --token-path ...
JOBMATE_GMAIL_TOKEN_PATH=
JOBMATE_CALENDAR_TOKEN_PATH=
# 서버리스(Vercel)용 — 토큰 JSON 전체를 env로 전달하면 임시 파일로 materialize.
# 로컬 `jobmate google-auth`가 만든 토큰 파일 내용을 그대로 붙여넣기.
JOBMATE_GMAIL_TOKEN_JSON=
JOBMATE_CALENDAR_TOKEN_JSON=
JOBMATE_AUTO_REGISTER=
JOBMATE_GMAIL_QUERY=
JOBMATE_GMAIL_POLL_INTERVAL_SECONDS=
JOBMATE_WORKER_INTERVAL_SECONDS=
JOBMATE_SLACK_SIGNING_SECRET=
JOBMATE_SLACK_CHANNEL_IDS=
JOBMATE_TELEGRAM_WEBHOOK_SECRET=
JOBMATE_TELEGRAM_CHAT_IDS=
# 메신저 웹훅 fail-open 탈출구 — Slack/Telegram 채널·chat id 허용 목록
# (위 *_CHANNEL_IDS / *_CHAT_IDS)이 비어 있으면 기본적으로 모든 메시지를
# 거부한다(fail-closed). 기존처럼 목록 없이 전체 허용하려면 1로 설정.
# 운영 환경에서는 허용 목록 설정 권장 (설정 시 기동/최초 사용에 경고 로그).
JOBMATE_MESSENGER_ALLOW_ALL=
# 메신저 커맨드 per-user allowlist (쉼표 구분 Slack user ID/Telegram user ID)
# 설정 시 승인/시작 커맨드 실행자가 이 목록에 없으면 거부한다.
# 미설정 시 채널 allowlist(SLACK_CHANNEL_IDS/TELEGRAM_CHAT_IDS)만 적용.
# Slack user ID는 이벤트 payload의 user 필드, Telegram은 from.id.
JOBMATE_MESSENGER_ALLOWED_USERS=
# skillRadar
GITHUB_TOKEN=
JOBMATE_RADAR_PLATFORMS=
JOBMATE_RADAR_PER_QUERY=
JOBMATE_RADAR_MAX_REPOS=
JOBMATE_RADAR_QUERIES_PATH=
# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# LangSmith 관측성 — 설정 시 LangGraph/LangSmith 트레이싱 활성화
LANGSMITH_API_KEY=
JOBMATE_LANGSMITH_TRACING=
JOBMATE_LANGSMITH_PROJECT=
# cron-job.org — 대시보드 설정 저장 시 실제 cron 스케줄 갱신
CRONJOB_ORG_API_KEY=
JOBMATE_CRONJOB_JOB_ID=
JOBMATE_CRONJOB_RADAR_JOB_ID=
# job id 미설정 시 자동 생성에 필요한 이 앱의 공개 URL (예: https://jobmate.example.com)
JOBMATE_PUBLIC_BASE_URL=
# 인증 메일 링크의 허용 Host 목록 (쉼표 구분, 예: jobmate.example.com,www.jobmate.example.com)
# PUBLIC_BASE_URL 미설정 시 인증 링크는 요청 Host로 생성된다 — 이 목록을 설정하면
# 목록에 없는 Host로 들어온 가입/재발송 요청의 메일 발송을 거부한다(Host 헤더
# 인젝션 피싱 링크 방지). 미설정 시 제한 없음(기존 동작).
JOBMATE_PUBLIC_HOSTS=

# 보안 — API 인증 + 저장 데이터 암호화
# 설정 시 모든 /api/* 요청에 X-API-Key 또는 Authorization: Bearer 필요
# (health, /api/v1/webhooks/*, /api/v1/cron/tick, /api/v1/auth/* 제외).
# 로컬에서 키/허용 이메일이 모두 없을 때만 인증 비활성. Vercel은 키가 없어도 비공개.
# 보호 환경의 비밀번호 가입은 X-API-Key 헤더에 관리자 키가 필요.
# 브라우저 사용자는 관리자가 생성한 계정 또는 허용된 Google 계정으로 로그인.
JOBMATE_API_KEY=
# Fernet 키(44자 urlsafe) 또는 임의 문자열(내부에서 SHA256 파생).
# 비우면 JOBMATE_API_KEY → CRON_SECRET 순으로 파생. 전부 없으면 암호화 비활성
JOBMATE_ENCRYPTION_KEY=
# 계정 로그인 — 이메일+비밀번호 / Google OAuth
# GOOGLE_CLIENT_ID/SECRET: Google Cloud Console > OAuth 2.0 클라이언트(웹)
# 승인된 리디렉션 URI: https://<도메인>/api/v1/auth/google/callback
# GOOGLE_REDIRECT_URI를 지정하면 base_url 대신 이 값을 사용 (비우면 요청 host에서 자동 생성)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 위와 동일한 설정의 GOOGLE_OAUTH_* 별칭 — 둘 다 설정 가능하며
# GOOGLE_OAUTH_* 가 우선한다 (GOOGLE_OAUTH_CLIENT_ID/SECRET/REDIRECT_URI)
# 쉼표 구분 허용 이메일 목록 — 설정 시 이 목록의 이메일만 가입/로그인 가능.
# 미설정 시 공개 가입/로그인. Google 로그인은 항상 email_verified=true 필요.
# 목록에서 제외한 사용자의 기존 세션도 다음 요청부터 거부.
JOBMATE_ALLOWED_EMAILS=

# agent-bridge — 로컬 세션 수집기가 push할 jobMate 서버 주소
# (jobmate agent-bridge --url 또는 이 env, 기본 http://127.0.0.1:8000)
JOBMATE_URL=

# 메신저 커맨드/알림 (Slack/Telegram 양방향)
# Slack: Incoming Webhook URL — 승인/현황/시작 커맨드 수신 채널과 알림 발송에 공용
JOBMATE_SLACK_WEBHOOK_URL=
# Telegram: BotFather 봇 토큰 + 알림 받을 chat_id (@userinfobot 등으로 확인)
JOBMATE_TELEGRAM_BOT_TOKEN=
JOBMATE_TELEGRAM_CHAT_ID=
# 쉼표 구분 관리자 이메일 — 설정 계정은 role과 무관하게 admin 권한
# (미설정 시 첫 가입 사용자와 users.role='admin'만 관리자)
JOBMATE_ADMIN_EMAILS=
# 쉼표 구분 팀장(lead) 이메일 — lead 전용 메뉴/집계 API 접근 (admin env가 우선)
JOBMATE_LEAD_EMAILS=
# 월 LLM 비용 예산(USD) — 대시보드 설정(settings POST의 monthly_budget_usd)으로도 설정 가능.
# 설정 시 GET /api/v1/usage/summary의 budget_usd/budget_exceeded에 반영.

# MCP — 외부 MCP 서버를 에이전트 도구로 연결 (src/jobmate/mcp/README.md 참고)
# JSON 배열 방식 (권장):
# JOBMATE_MCP_SERVERS='[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]'
# 또는 세미콜론 구분: JOBMATE_MCP_SERVERS="fs=npx -y @mcp/server-fs /tmp; gh=uvx mcp-server-github"
# 단일 서버 단축키:
# JOBMATE_MCP_SERVER_CMD="npx -y @modelcontextprotocol/server-filesystem /tmp"
# JOBMATE_MCP_SERVER_NAME=fs        # 선택, 기본 "default"
# JOBMATE_MCP_SERVER_ARGS="--flag x"  # 선택, CMD 뒤에 추가
# jobMate 자체를 MCP 서버로 노출: python -m jobmate.mcp.server (stdio 전용 —
# JOBMATE_MCP_TRANSPORT을 http/sse로 바꿔도 인증 없이 기동 거부됨)
JOBMATE_MCP_SERVERS=
JOBMATE_MCP_SERVER_CMD=
JOBMATE_MCP_SERVER_NAME=
JOBMATE_MCP_SERVER_ARGS=

# run_tests 도구 허용 명령 접두사 추가 (쉼표 구분, 기본: pytest/ruff/mypy)
# 셸·인터프리터 바이너리(bash/sh/cmd/python -c 등)는 env로도 허용 불가
# 예: JOBMATE_TEST_COMMAND_PREFIXES=pnpm test, uv run pytest
JOBMATE_TEST_COMMAND_PREFIXES=

# 이메일 인증 메일 발송 (SMTP) — 비밀번호 가입 인증 링크용
# 미설정 시 인증 메일 발송 불가 → 로컬 로그에만 링크 출력, Vercel에서는 재발송 안내
JOBMATE_SMTP_HOST=
JOBMATE_SMTP_PORT=587
JOBMATE_SMTP_USER=
JOBMATE_SMTP_PASS=
JOBMATE_SMTP_FROM=
# JOBMATE_SMTP_TLS=starttls  # starttls(기본) | ssl(465 등 implicit TLS) | none

# ── 추가 환경변수 (config.py Settings 외 직접 읽기) ──
# Codex OAuth 토큰 파일 경로 (기본 ~/.codex/auth.json)
JOBMATE_CODEX_AUTH_PATH=
# MCP 서버 모드 DSN — Settings/DB 경로 해석 실패 시 폴백 (기본 data/jobmate.db) — stdio 전용
JOBMATE_DB_DSN=
# MCP 전송 방식 — stdio(기본)만 지원. http/sse는 인증 없이 기동 거부됨
JOBMATE_MCP_TRANSPORT=
# LangSmith trace 샘플링 비율 0~1 (기본 1.0) — 백그라운드 잡 비용 절감용
JOBMATE_LANGSMITH_SAMPLE_RATE=
# 동시 실행 run 상한 (기본 4) — Gmail 대량 수신 시 LLM 폭주 방지
JOBMATE_MAX_CONCURRENT_RUNS=
# 세션 스캐너 repo 탐색 루트 override (os.pathsep 구분, 기본 자동탐색)
JOBMATE_REPO_ROOTS=
# Slack 봇 토큰 (xoxb-...) — webhook만으로는 스레드 답글 불가, 설정 시 chat.postMessage 사용
JOBMATE_SLACK_BOT_TOKEN=
#
# 암호화 키 로테이션 참고: JOBMATE_ENCRYPTION_KEY를 교체하면 새 데이터는 새 키로
# 암호화되지만 기존 "enc:v1:" 블롭은 복호화 불가(단일 키만 지원).
# 로테이션 절차: ① 기존 키로 전수 복호화→재암호화 스크립트 실행
# ② 새 키 설정 후 재기동. 계획된 로테이션 없으면 키 변경 금지.
